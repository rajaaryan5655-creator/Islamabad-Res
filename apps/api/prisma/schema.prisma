// AUTO-GENERATED by scripts/gen-schema.mjs — do not edit by hand.
// Provider resolved from DATABASE_URL: sqlite
// Edit scripts/schema.models.prisma instead, then run `npm run db:schema`.
//
// Prisma 7: the connection URL lives in prisma.config.ts / the driver adapter
// passed to PrismaClient, not in this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

/* =============================================================================
   Islamabad Restaurant — data model
   Enum-like columns are stored as String and validated at the edge with Zod so
   the identical model set compiles on both PostgreSQL and SQLite.
   Scalar lists are stored as JSON strings (see prisma/json.ts helpers).
   ============================================================================= */

/* ------------------------------- identity -------------------------------- */

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  phone          String?
  name           String
  passwordHash   String?
  role           String    @default("CUSTOMER") // SUPER_ADMIN | MANAGER | STAFF | CUSTOMER
  position       String?
  avatarUrl      String?
  provider       String    @default("local") // local | google | facebook
  providerId     String?
  emailVerified  Boolean   @default(false)
  isActive       Boolean   @default(true)
  marketingOptIn Boolean   @default(false)
  dietaryPrefs   String    @default("[]") // JSON string[]
  points         Int       @default(0)
  lifetimePoints Int       @default(0)
  tier           String    @default("BRONZE")
  referralCode   String    @unique
  referredById   String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  tokens        VerificationToken[]
  pushSubs      PushSubscription[]
  emailLogs     EmailLog[]
  reservations  Reservation[]
  reviews       Review[]
  pointsLedger  PointsEntry[]
  sessions      Session[]
  notifications Notification[]
  giftCards     GiftCard[]      @relation("GiftCardPurchaser")
  auditLogs     AuditLog[]

  @@index([role])
  @@index([tier])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  line1     String
  line2     String?
  city      String   @default("Islamabad")
  zoneId    String
  notes     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

/* --------------------------------- menu ---------------------------------- */

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MenuItem[]

  @@index([sortOrder])
}

model MenuItem {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String
  price          Int // minor-unit-free PKR (whole rupees)
  compareAtPrice Int?
  cost           Int? // internal food cost for margin reporting
  categoryId     String
  image          String
  gallery        String   @default("[]") // JSON string[]
  calories       Int?
  protein        Int?
  carbs          Int?
  fat            Int?
  spiceLevel     String   @default("MEDIUM") // MILD | MEDIUM | HOT | FIERY
  allergens      String   @default("[]") // JSON string[]
  tags           String   @default("[]") // JSON string[]
  isVegetarian   Boolean  @default(false)
  isAvailable    Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  isBestSeller   Boolean  @default(false)
  prepMinutes    Int      @default(20)
  serves         Int      @default(1)
  rating         Float    @default(4.5)
  ratingCount    Int      @default(0)
  orderCount     Int      @default(0)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  reviews      Review[]
  optionGroups MenuOptionGroup[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([isFeatured])
  @@index([orderCount])
}

/* -------------------------------- orders --------------------------------- */

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  userId         String?
  addressId      String?
  type           String // DELIVERY | PICKUP | DINE_IN
  status         String   @default("PENDING")
  customerName   String
  customerPhone  String
  customerEmail  String?
  addressText    String?
  zoneId         String?
  tableNumber    String?
  notes          String?
  subtotal       Int
  packaging      Int      @default(0)
  deliveryFee    Int      @default(0)
  discount       Int      @default(0)
  pointsDiscount Int      @default(0)
  pointsRedeemed Int      @default(0)
  tax            Int      @default(0)
  total          Int
  pointsEarned   Int      @default(0)
  couponCode     String?
  giftCardCode   String?
  giftCardAmount Int      @default(0)
  paymentMethod  String
  paymentStatus  String   @default("UNPAID")
  paymentRef     String?
  etaMinutes     Int?
  scheduledFor   DateTime?
  confirmedAt    DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  refundedAmount Int      @default(0)
  refundedAt     DateTime?
  refundReason   String?
  trackingToken  String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  events  OrderEvent[]
  payment Payment?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  menuItemId String
  name       String
  unitPrice  Int
  quantity   Int
  total      Int
  notes      String?
  options    String  @default("[]") // JSON: [{groupId,groupName,choiceId,label,priceDelta}]

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id         String   @id @default(cuid())
  orderId    String   @unique
  provider   String // stripe | paypal | jazzcash | easypaisa | manual
  method     String
  status     String   @default("UNPAID")
  amount     Int
  currency   String   @default("PKR")
  intentId   String?
  receiptUrl String?
  rawPayload String? // JSON
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/* ----------------------------- reservations ------------------------------ */

model RestaurantTable {
  id       String  @id
  name     String
  seats    Int
  zone     String // INDOOR | OUTDOOR | PRIVATE
  isActive Boolean @default(true)

  reservations Reservation[]
}

model Reservation {
  id          String   @id @default(cuid())
  code        String   @unique
  userId      String?
  tableId     String?
  name        String
  email       String
  phone       String
  date        String // YYYY-MM-DD, timezone-stable
  time        String // HH:mm
  guests      Int
  durationMin Int      @default(90)
  seating     String   @default("ANY")
  occasion    String?
  requests    String?
  status      String   @default("PENDING")
  waitlistPos Int?
  approvedAt  DateTime?
  approvedById String?
  rejectionReason String?
  seatedAt    DateTime?
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  table RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([date, time])
  @@index([status])
  @@index([userId])
}

/* ------------------------------- marketing ------------------------------- */

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String?
  /** Lowercased email — the only stable identity a guest checkout gives us. */
  email     String?
  phone     String?
  orderId   String   @unique
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([couponId, email])
  @@index([couponId, phone])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  type        String // PERCENT | FIXED | FREE_DELIVERY
  value       Float
  minOrder    Int      @default(0)
  maxDiscount Int?
  usageLimit  Int?
  usageCount  Int      @default(0)
  perUserLimit Int?
  startsAt    DateTime @default(now())
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  source       String   @default("footer")
  isSubscribed Boolean  @default(true)
  createdAt    DateTime @default(now())
  unsubscribedAt DateTime?
}

model Campaign {
  id         String   @id @default(cuid())
  name       String
  subject    String
  body       String
  segment    String   @default("ALL")
  status     String   @default("DRAFT") // DRAFT | SCHEDULED | SENT
  scheduledAt DateTime?
  sentAt     DateTime?
  recipients Int      @default(0)
  opens      Int      @default(0)
  clicks     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW") // NEW | READ | REPLIED | ARCHIVED
  createdAt DateTime @default(now())

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // ORDER | RESERVATION | PROMO | SYSTEM
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/* ------------------------------- loyalty --------------------------------- */

model PointsEntry {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  orderId   String?
  balance   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GiftCard {
  id             String   @id @default(cuid())
  code           String   @unique
  amount         Int
  balance        Int
  purchaserId    String?
  recipientName  String
  recipientEmail String
  senderName     String
  message        String?
  status         String   @default("ACTIVE") // ACTIVE | REDEEMED | EXPIRED
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaser User? @relation("GiftCardPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
}

/* -------------------------------- events --------------------------------- */

model EventEnquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  type      String // PRIVATE_DINING | CATERING | BIRTHDAY | CORPORATE | WEDDING
  date      String
  guests    Int
  budget    Int?
  details   String?
  status    String   @default("NEW") // NEW | CONTACTED | QUOTED | WON | LOST
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/* -------------------------------- reviews -------------------------------- */

model Review {
  id         String   @id @default(cuid())
  userId     String?
  menuItemId String?
  rating     Int
  title      String?
  body       String
  isApproved Boolean  @default(false)
  reply      String? // owner response, shown under the review
  repliedAt  DateTime?
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([isApproved])
}

/* ------------------------------- operations ------------------------------ */

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  action   String
  entity   String
  entityId String?
  meta     String? // JSON
  ip       String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}


/* ---------------------------- menu customization -------------------------- */

model MenuOptionGroup {
  id         String  @id @default(cuid())
  menuItemId String
  name       String // "Portion", "Spice level", "Add-ons"
  type       String  @default("SINGLE") // SINGLE | MULTI
  isRequired Boolean @default(false)
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1)
  sortOrder  Int     @default(0)

  menuItem MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  choices  MenuOptionChoice[]

  @@index([menuItemId])
}

model MenuOptionChoice {
  id         String  @id @default(cuid())
  groupId    String
  label      String
  priceDelta Int     @default(0) // may be negative
  isDefault  Boolean @default(false)
  isAvailable Boolean @default(true)
  sortOrder  Int     @default(0)

  group MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

/* ------------------------------ auth tokens ------------------------------- */

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

/* ----------------------------- notifications ------------------------------ */

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String?
  to        String
  subject   String
  kind      String
  status    String   @default("SENT") // SENT | FAILED
  error     String?
  body      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

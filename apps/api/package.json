{
  "name": "@islamabad/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate",
    "dev": "tsx watch src/index.ts",
    "build": "npm run generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "tsx scripts/apply-sql.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:reset": "tsx scripts/apply-sql.ts --reset && tsx prisma/seed.ts",
    "generate": "node ../../scripts/gen-schema.mjs && node ../../scripts/gen-sql.mjs && node ../../scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@islamabad/shared": "*",
    "@prisma/client": "7.9.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nanoid": "^5.1.5",
    "zod": "^4.4.3",
    "@prisma/adapter-libsql": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@libsql/client": "^0.17.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "prisma": "7.9.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/pg": "^8.15.6"
  }
}
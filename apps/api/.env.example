# Local development — SQLite keeps the platform runnable with zero services.
# Production: swap for a PostgreSQL URL, e.g.
# DATABASE_URL="postgresql://user:pass@db.internal:5432/islamabad?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/islamabad?schema=public"

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET="dev-access-secret-change-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production"
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Optional — falls back to an in-process LRU when unset.
REDIS_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

SENTRY_DSN=
